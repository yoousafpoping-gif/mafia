PORT=4000
# رابط الفرونت في الإنتاج (Vercel) — بيتحقن كـ CORS تلقائيًا.
# CORS_ORIGIN بيغلب لو موجود (بيقبل قائمة بفواصل).
CLIENT_URL=http://localhost:3000
# CORS_ORIGIN=*
LOG_LEVEL=info
# مكان ملفات البيانات (بروفايلات/مفاتيح VAPID/اشتراكات الدفع)
# على Render: وجّهها لديسك دائم زي /var/data — محليًا مش محتاج تغيرها
DATA_DIR=data
NIGHT_MS=30000
DAY_DISCUSSION_MS=75000
DAY_VOTING_MS=30000
REVENGE_MS=15000
SWEEP_INTERVAL_MS=60000
EMPTY_ROOM_TTL_MS=120000
ROOM_IDLE_TTL_MS=1800000
